# NOURA API — environment template. PLACEHOLDERS ONLY. Copy to apps/api/.env for local use;
# .env files are git-ignored and must never be committed. Deployed environments inject these
# from the hosting provider's secret store.

# development | test | staging | production. staging/production refuse mocks and plain http.
APP_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=false

# Server-side Postgres connection. Local Supabase CLI default shown; in deployed environments use a
# dedicated login role that has been granted noura_api (see docs/runbooks/database.md).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
PGBOSS_SCHEMA=pgboss

# Supabase project URL. Issuer and JWKS URL are derived from it unless overridden.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# AI provider (server only, never in the app). Development defaults to the explicit mock.
AI_PROVIDER=mock
# AI_API_KEY=replace-with-provider-key
# AI_MODEL_ID=replace-with-pinned-model-id

# Target policy for automated planning (docs/decisions.md D-018). Development and test default to the
# clearly labelled TEST policy. Staging and production plan only with an APPROVED policy file; a test
# policy there refuses to start, and with no file planning is simply unavailable.
# PLANNING_POLICY_FILE=/run/secrets/planning-policy.json

# Billing (M10). Development defaults to the explicit mock.
BILLING_PROVIDER=mock
# REVENUECAT_SECRET_API_KEY=replace-with-revenuecat-secret
# REVENUECAT_WEBHOOK_AUTH=replace-with-long-random-webhook-authorization
