{
  "name": "@noura/api",
  "private": true,
  "type": "module",
  "description": "NOURA Fastify API (auth, business rules, all domain writes).",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@noura/contracts": "workspace:*",
    "@noura/domain": "workspace:*",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
