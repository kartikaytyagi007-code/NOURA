# NOURA worker — environment template. PLACEHOLDERS ONLY. Copy to apps/worker/.env locally.

APP_ENV=development
LOG_LEVEL=info

# Use a session-mode or direct connection (pg-boss needs LISTEN/advisory locks; not the
# transaction pooler). Deployed environments use a dedicated login role granted noura_worker.
WORKER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
WORKER_DB_POOL_MAX=5
WORKER_CONCURRENCY=2
PGBOSS_SCHEMA=pgboss
# true in development/test; deployed environments run `pnpm --filter @noura/worker queue:migrate`
# as a release step and keep this false.
PGBOSS_MIGRATE=true

WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=8081

AI_PROVIDER=mock
# AI_API_KEY=replace-with-provider-key
# AI_MODEL_ID=replace-with-pinned-model-id
