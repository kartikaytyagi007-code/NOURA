{
  "name": "noura",
  "private": true,
  "type": "module",
  "description": "NOURA (working name) monorepo: Flutter mobile app, Fastify API, pg-boss worker, Supabase SQL.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "db:reset:local": "pnpm --filter @noura/db run reset:plain",
    "contracts:lint": "pnpm --filter @noura/contracts run lint",
    "contracts:generate": "pnpm --filter @noura/contracts run generate",
    "contracts:check": "node scripts/check-contract-drift.mjs",
    "secrets:check": "node scripts/check-no-secrets.mjs",
    "dev:api": "pnpm --filter @noura/api run dev",
    "dev:worker": "pnpm --filter @noura/worker run dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "supabase": "2.119.0",
    "typescript-eslint": "8.71.0"
  }
}
