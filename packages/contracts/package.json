{
  "name": "@noura/contracts",
  "private": true,
  "type": "module",
  "description": "OpenAPI contract (authority for API + generated clients) and generated TypeScript types.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "dist",
    "openapi.yaml",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "redocly lint openapi.yaml --config redocly.yaml",
    "generate": "pnpm run generate:ts && pnpm run generate:dart",
    "generate:ts": "openapi-typescript openapi.yaml -o generated/ts/openapi.d.ts && prettier --write generated/ts/openapi.d.ts",
    "generate:dart": "node scripts/generate-dart.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@redocly/cli": "2.57.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "vitest": "5.0.3"
  }
}
