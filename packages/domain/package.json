{
  "name": "@noura/domain",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript domain modules used by API and worker. Flutter never reimplements these.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
