# Supabase CLI local auth settings — PLACEHOLDERS ONLY. Copy to supabase/.env (git-ignored).
# Referenced from config.toml via env(...). Leave blank to keep a provider disabled locally.
# SMS gateway for phone sign-in (D-033). Without it, use the [auth.sms.test_otp] number locally.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
# Unused since D-033 (phone-only sign-in); kept so config.toml's env() references resolve.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
